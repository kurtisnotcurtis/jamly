{
  "manifest_version": 3,
  "name": "Jamly",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Create drums and drumless tracks using a paired local Jamly backend.",
  "author": "jamly",
  "background": {
    "service_worker": "jamly_extension_bg.js"
  },
  "action": {
    "default_popup": "jamly_popup.html",
    "default_title": "Jamly"
  },
  "options_ui": {
    "page": "jamly_options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": []
}
